# LegalSaathi Wave 2 video plane — ENVIRONMENT TEMPLATE (SAATHI-451, row H1).
#
# THIS FILE CONTAINS NO CREDENTIALS AND NEVER WILL. Every secret-shaped value
# below is the literal string `changeme`, which is in the frozen placeholder set
# in backend/app/core/config.py (_PLACEHOLDER_SECRETS) AND in
# video_provider.py (_DEV_DEFAULT_SECRETS). A deployment that copies this file
# and forgets to edit it therefore CANNOT boot:
#   * Settings() raises ConfigurationError naming livekit_api_key/secret, and
#   * LiveKitCommunityAdapter refuses to construct (PROVIDER_MISCONFIGURED).
# Hosts are `.invalid` (RFC 2606) and addresses are RFC 5737 documentation
# addresses, so nothing here can be mistaken for a real endpoint either.
# backend/tests/test_wave2_video_infra.py asserts all of the above.
#
# HOW TO USE. Append the block you need to the deployment's real `.env` (which is
# gitignored) and then render the service configs:
#   python3 scripts/render_video_infra_config.py --env-file .env
# Rotation: RUNBOOK § "Credential rotation".

# ---------------------------------------------------------------------------
# 1. READ BY THE BACKEND. Names are the uppercased field names of
#    backend/app/core/config.py::Settings — pydantic-settings maps them 1:1.
#    Do not rename anything here without renaming the Settings field.
# ---------------------------------------------------------------------------
# Product/operations switch and provider binding are independent. The checked-in
# example is fail-closed: copying it can never expose a fake production room.
VIDEO_CALLS_ENABLED=false
# One of: deterministic | livekit | none (config.py::VIDEO_PROVIDER_CHOICES).
# `deterministic` is test/development-only and is never a production fallback.
VIDEO_PROVIDER=none
# MUST be http:// or https://, WITH a host. LiveKitCommunityAdapter._twirp POSTs
# to {LIVEKIT_URL}/twirp/livekit.RoomService/<Method> with httpx, so anything else
# could only fail every server-side call (revoke_participant / close_room) at
# runtime with PROVIDER_UNREACHABLE. With VIDEO_PROVIDER=livekit that is now a
# refusal to boot: Settings raises ConfigurationError naming LIVEKIT_URL (see
# backend/app/core/config.py::_livekit_url_problem).
# From another compose service: http://livekit:7880 . From the host: http://localhost:1039 .
# The wss:// URL that browsers connect to is a separate FRONTEND setting; the
# backend never uses it.
LIVEKIT_URL=http://localhost:1039
# Browser-facing signalling endpoint. Local development may use ws://localhost;
# staging/production requires wss:// backed by a trusted certificate.
LIVEKIT_PUBLIC_URL=ws://localhost:1039
# Browser ICE policy: `all` permits direct plus TURN fallback; `relay` forces
# the media path through TURN. Use relay for the self-hosted restrictive-network
# profile and all for the direct-path diagnostic profile.
VIDEO_ICE_TRANSPORT_POLICY=relay
LIVEKIT_API_KEY=changeme
LIVEKIT_API_SECRET=changeme
# Join credential lifetime. Short-lived by design; only the SHA-256 hash is ever
# stored (video_session_grants has no raw-token column).
JOIN_CREDENTIAL_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# 2. READ BY THE INFRA ONLY — scripts/render_video_infra_config.py and
#    infra/video/docker-compose.video.yml. The backend never sees these.
# ---------------------------------------------------------------------------
# The hostname clients are told to send relayed media to. Must resolve for the
# CLIENT, not for the SFU.
TURN_PUBLIC_HOST=turn.legalsaathi.invalid
# Browser-facing TURN listener. The repository's local Compose mapping is
# host 1043 -> container 3478; set 3478/443 when that is what staging exposes.
TURN_PUBLIC_PORT=1043
# coturn realm for the long-term-credential mechanism. Conventionally the same
# as TURN_PUBLIC_HOST.
TURN_REALM=turn.legalsaathi.invalid
# The relay's own reachable address (coturn `external-ip`). A container only sees
# its private address, so this must be supplied explicitly.
TURN_EXTERNAL_IP=203.0.113.10
# Shared secret for TURN REST credentials. LiveKit derives a short-lived
# username/password from it per client; coturn validates with the same secret.
# Generate with: openssl rand -hex 32
TURN_STATIC_AUTH_SECRET=changeme
# Lifetime of those derived TURN credentials, in seconds. Long enough to cover a
# whole session plus reconnects; short enough that a captured credential dies.
TURN_CREDENTIAL_TTL_SECONDS=3600
# Where LiveKit POSTs room events. MUST be the committed E2 route:
# backend/app/api/v1/tutoring.py -> POST /api/v1/video/webhook .
# `backend` is the root compose service name. LiveKit signs each delivery with a
# JWT in the `Authorization` header whose `sha256` claim is the base64 SHA-256 of
# the exact body; LiveKitCommunityAdapter verifies exactly that, so the transports
# agree. It signs with the LIVEKIT_API_KEY/LIVEKIT_API_SECRET pair above — if they
# differ from the backend's, every delivery is refused 400 VIDEO_UNVERIFIED.
# See RUNBOOK § 0(a) and § 9 item 6.
VIDEO_WEBHOOK_URL=http://backend:1031/api/v1/video/webhook
# DIRECT MODE ONLY (docker-compose.video.direct.yml). The address the SFU puts
# in its own ICE candidates; must be reachable BY THE CLIENT. Unused — and
# ignored — in the default forced-TURN mode, where the SFU's advertised address
# is hard-coded to the docker-internal 172.29.30.10 so it cannot be widened by
# an environment variable.
LIVEKIT_ADVERTISE_IP=203.0.113.11
