# macOS
.DS_Store
.AppleDouble
.LSOverride

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
# Rendered video-plane configs (SAATHI-451): generated from infra/video/*.tmpl by
# scripts/render_video_infra_config.py and they hold real secrets. Templates and
# infra/video/.env.example ARE tracked; anything rendered never is.
infra/video/rendered/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
# Platform-scoped virtualenvs: `.venv-$(uname -s)-$(uname -m)`, e.g.
# .venv-Linux-aarch64 / .venv-Darwin-arm64. A virtualenv is machine-bound
# (pyvenv.cfg names a builder interpreter, site-packages hold ABI-tagged
# binaries), so one shared `.venv` path read from two operating systems is
# healthy on one and unusable on the other. These must stay untracked too.
.venv-*/
venv-*/
ENV/

# Node / frontend
node_modules/
dist/
build/
.vite/
.next/
coverage/

# Capacitor native build artifacts
frontend/ios/App/build/
frontend/android/app/build/
frontend/android/.gradle/
frontend/android/build/

# Runtime data
logs/
*.log
!Logs/
!Logs/README.md
!Logs/app/
Logs/app/*.jsonl
!Logs/app/.gitkeep
!Logs/logstash/
!Logs/logstash/config/
!Logs/logstash/config/logstash.yml
!Logs/logstash/pipeline/
!Logs/logstash/pipeline/logstash.conf
!Logs/logstash/state/
!Logs/processed/
Logs/processed/*.jsonl
!Logs/processed/.gitkeep
Logs/logstash/state/*
!Logs/logstash/state/.gitkeep
storage/uploads/*
!storage/uploads/.gitkeep
storage/vectorstore/*
!storage/vectorstore/.gitkeep

# Local data, keep samples tracked
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# ML / vector artifacts
*.faiss
*.index
*.sqlite3
*.db
*.parquet
*.pkl
*.joblib

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Generated browser-gate evidence: never enters a production commit.
test-results/

# Wave-specific raw release evidence remains local/Jira-attached. Committing
# screenshots, runtime logs or capability-scan payloads makes the tested hash
# self-referential and previously bloated the Wave 5 branch with failed runs.
QA/evidence/SAATHI-295/final_*/
