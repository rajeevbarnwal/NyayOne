# NyayOne local dev — isolated on host port range 1130-1149.
# Container ports remain internal implementation details; these host ports keep
# NyayOne from sharing LegalSaathi's local runtime namespace.

# Backend
APP_ENV=development
LOG_LEVEL=INFO
LOG_FILE_PATH=/workspace/Logs/app/backend.jsonl
BACKEND_HOST=0.0.0.0
BACKEND_PORT=1131
# Frontend dev origin(s) allowed by CORS
CORS_ORIGINS=["http://localhost:1130","http://127.0.0.1:1130"]

# --- Database (Postgres + pgvector; host 1132 -> container 5432) ---
# Development-only credentials; deployment secrets must be supplied separately.
DATABASE_URL=postgresql+psycopg://nyayone:nyayone_dev_only@localhost:1132/nyayone
# Optional dedicated test DB; when unset, the test suite uses SQLite in-memory.
TEST_DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Config-ready placeholders (declared for later tickets; leave blank in foundation) ---
# Cache/queue broker — Valkey (BSD, Redis-compatible) reserved on 1133
VALKEY_URL=
# Object storage — S3-compatible abstraction; local default SeaweedFS S3 API on 1135 (admin/UI 1136)
STORAGE_ENDPOINT_URL=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Internal LLM Gateway (local open-weight: Ollama dev / vLLM prod) reserved on 1137.
# No cloud LLM keys are used; inference is fronted by the gateway.
LLM_GATEWAY_URL=

# Frontend
VITE_API_BASE_URL=http://localhost:1131
VITE_APP_NAME=NyayOne

# --- Student registration security / delivery ------------------------------
# Development placeholders only. Production/staging fail closed unless both
# secrets are replaced with strong, independently managed values.
REGISTRATION_SECRET=dev-registration-secret-change-me
REGISTRATION_LOOKUP_SECRET=dev-registration-lookup-change-me
REGISTRATION_KEY_VERSION=v1
# Rotation format: ["v0:previous-encryption-secret"]
REGISTRATION_PRIOR_KEYS=[]

# OTP is disabled unless a concrete provider is configured. The "capturing"
# provider is test/dev-only; use "http" plus a deployment-owned endpoint.
OTP_DELIVERY_ENABLED=false
OTP_PROVIDER=none
OTP_PROVIDER_URL=
OTP_PROVIDER_TOKEN=
OTP_PROVIDER_TIMEOUT_S=10
OTP_PROVIDER_SUPPORTS_IDEMPOTENCY=false
OTP_CHALLENGE_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_LOCKOUT_SECONDS=900
OTP_MAX_ATTEMPTS=3
OTP_ATTEMPT_WINDOW_SECONDS=900
OTP_RESEND_WINDOW_SECONDS=900
OTP_MAX_RESENDS_PER_WINDOW=3
OTP_ISSUE_RATE_WINDOW_SECONDS=600
OTP_ISSUE_IDENTITY_LIMIT=5
OTP_ISSUE_IP_LIMIT=20
OTP_ISSUE_GLOBAL_LIMIT=200
OTP_RESEND_RATE_WINDOW_SECONDS=900
OTP_RESEND_IDENTITY_LIMIT=3
OTP_RESEND_IP_LIMIT=10
OTP_RESEND_GLOBAL_LIMIT=100
OTP_VERIFY_RATE_WINDOW_SECONDS=900
OTP_VERIFY_IDENTITY_LIMIT=10
OTP_VERIFY_IP_LIMIT=30
OTP_VERIFY_GLOBAL_LIMIT=300
OTP_OUTBOX_LEASE_SECONDS=30
OTP_OUTBOX_MAX_ATTEMPTS=5
OTP_OUTBOX_RETRY_BASE_SECONDS=10
OTP_OUTBOX_RETRY_MAX_SECONDS=300
OTP_RATE_BUCKET_RETENTION_SECONDS=604800
OTP_SECURITY_STATE_RETENTION_SECONDS=604800
OTP_OUTBOX_LEGACY_DESTINATION_RETENTION_SECONDS=604800
OTP_FLOW_COOKIE_NAME=nyayone_otp_flow
OTP_FLOW_TTL_SECONDS=600
OTP_RECOVERY_PROOF_TTL_SECONDS=300

# --- Wave 2 tutoring video -------------------------------------------------
# Safe default: UI and join issuance are disabled until an operator explicitly
# enables the real provider. `deterministic` is test/development-only.
VIDEO_CALLS_ENABLED=false
VIDEO_PROVIDER=none
LIVEKIT_URL=
LIVEKIT_PUBLIC_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
JOIN_CREDENTIAL_TTL_SECONDS=300

# Counsel/deployment-owned retention policy. Blank means no automatic expiry;
# no statutory duration is hard-coded in the application.
RETENTION_DAYS_REGISTRATION_PENDING=
RETENTION_DAYS_REGISTRATION_INACTIVE=
RETENTION_DAYS_OTP_CHALLENGE=
RETENTION_DAYS_RECOVERY_SESSION=
RETENTION_DAYS_AUDIT_EVENTS=
RETENTION_MODE=anonymise

# GitHub integration
GITHUB_REPOSITORY=rajeevbarnwal/NyayOne
GITHUB_REPO_URL=https://github.com/rajeevbarnwal/NyayOne
GITHUB_TOKEN=

# Jira integration
JIRA_BASE_URL=https://legalsaathi.atlassian.net
JIRA_PROJECT_KEY=NYAY
JIRA_BOARD_ID=68
JIRA_EMAIL=
JIRA_API_TOKEN=
